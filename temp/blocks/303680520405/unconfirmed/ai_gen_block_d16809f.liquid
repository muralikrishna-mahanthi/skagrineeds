{% doc %}
  @prompt
    create a four words with background colors settings with font style settings, font family settings, and size of that background settings, corner radius settings and make them as 2 words per row and 2 rows like wrap in mobile view like a single word per column and 4 words down by down and desktop view 2 words per row and give padding settings for them
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-word-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-word-grid-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.gap }}px;
  }

  .ai-word-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.padding }}px;
    border-radius: {{ block.settings.corner_radius }}px;
    text-align: center;
    word-wrap: break-word;
  }

  .ai-word-item-{{ ai_gen_id }}-1 {
    background-color: {{ block.settings.word_1_bg_color }};
    color: {{ block.settings.word_1_text_color }};
    font-family: {{ block.settings.word_1_font.family }}, {{ block.settings.word_1_font.fallback_families }};
    font-weight: {{ block.settings.word_1_font.weight }};
    font-style: {{ block.settings.word_1_font.style }};
    font-size: {{ block.settings.word_1_font_size }}px;
  }

  .ai-word-item-{{ ai_gen_id }}-2 {
    background-color: {{ block.settings.word_2_bg_color }};
    color: {{ block.settings.word_2_text_color }};
    font-family: {{ block.settings.word_2_font.family }}, {{ block.settings.word_2_font.fallback_families }};
    font-weight: {{ block.settings.word_2_font.weight }};
    font-style: {{ block.settings.word_2_font.style }};
    font-size: {{ block.settings.word_2_font_size }}px;
  }

  .ai-word-item-{{ ai_gen_id }}-3 {
    background-color: {{ block.settings.word_3_bg_color }};
    color: {{ block.settings.word_3_text_color }};
    font-family: {{ block.settings.word_3_font.family }}, {{ block.settings.word_3_font.fallback_families }};
    font-weight: {{ block.settings.word_3_font.weight }};
    font-style: {{ block.settings.word_3_font.style }};
    font-size: {{ block.settings.word_3_font_size }}px;
  }

  .ai-word-item-{{ ai_gen_id }}-4 {
    background-color: {{ block.settings.word_4_bg_color }};
    color: {{ block.settings.word_4_text_color }};
    font-family: {{ block.settings.word_4_font.family }}, {{ block.settings.word_4_font.fallback_families }};
    font-weight: {{ block.settings.word_4_font.weight }};
    font-style: {{ block.settings.word_4_font.style }};
    font-size: {{ block.settings.word_4_font_size }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-word-grid-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<div class="ai-word-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-word-grid-container-{{ ai_gen_id }}">
    <div class="ai-word-item-{{ ai_gen_id }} ai-word-item-{{ ai_gen_id }}-1">
      {{ block.settings.word_1 }}
    </div>
    <div class="ai-word-item-{{ ai_gen_id }} ai-word-item-{{ ai_gen_id }}-2">
      {{ block.settings.word_2 }}
    </div>
    <div class="ai-word-item-{{ ai_gen_id }} ai-word-item-{{ ai_gen_id }}-3">
      {{ block.settings.word_3 }}
    </div>
    <div class="ai-word-item-{{ ai_gen_id }} ai-word-item-{{ ai_gen_id }}-4">
      {{ block.settings.word_4 }}
    </div>
  </div>
</div>

