{% doc %}
  @prompt
    Create a text block where the font size is responsive: 20px on mobile view and 48px on desktop view. Include a schema with a text setting so the merchant can edit the text content. Use CSS media queries to handle the responsive font sizes.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-responsive-text-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    color: {{ block.settings.text_color }};
    text-align: {{ block.settings.text_alignment }};
    font-size: 20px;
  }

  @media screen and (min-width: 750px) {
    .ai-responsive-text-{{ ai_gen_id }} {
      font-size: 48px;
    }
  }
{% endstyle %}

<div {{ block.shopify_attributes }}>
  <p class="ai-responsive-text-{{ ai_gen_id }}">
    {{ block.settings.text_content }}
  </p>
</div>

{% schema %}
{
  "name": "Responsive text",
  "settings": [
    {
      "type": "text",
      "id": "text_content",
      "label": "Text content",
      "default": "Your text here"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Responsive text"
    }
  ]
}
{% endschema %}
