{% doc %}
  @prompt
    Create a text block where the font size is responsive: 20px on mobile view and 48px on desktop view. Include a schema with a text setting so the merchant can edit the text content. Use CSS media queries to handle the responsive font sizes., include these complete settings for customization of font family from google fonts, font size for mobile view and desktop view different settings, and font weight different for mobile view and desktop view to change them and letter spacing, word spacing
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-responsive-text-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    color: {{ block.settings.text_color }};
    text-align: {{ block.settings.text_alignment }};
    font-family: {{ block.settings.font_family.family }}, {{ block.settings.font_family.fallback_families }};
    font-weight: {{ block.settings.font_family.weight }};
    font-size: {{ block.settings.mobile_font_size }}px;
    font-weight: {{ block.settings.mobile_font_weight }};
    letter-spacing: {{ block.settings.mobile_letter_spacing }}px;
    word-spacing: {{ block.settings.mobile_word_spacing }}px;
  }

  @media screen and (min-width: 750px) {
    .ai-responsive-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.desktop_font_size }}px;
      font-weight: {{ block.settings.desktop_font_weight }};
      letter-spacing: {{ block.settings.desktop_letter_spacing }}px;
      word-spacing: {{ block.settings.desktop_word_spacing }}px;
    }
  }
{% endstyle %}

<div {{ block.shopify_attributes }}>
  <p class="ai-responsive-text-{{ ai_gen_id }}">
    {{ block.settings.text_content }}
  </p>
</div>

{% schema %}
{
  "name": "Responsive text",
  "settings": [
    {
      "type": "text",
      "id": "text_content",
      "label": "Text content",
      "default": "Your text here"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "font_family",
      "label": "Font",
      "default": "helvetica_n4"
    },
    {
      "type": "header",
      "content": "Mobile typography"
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "label": "Font size",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_font_weight",
      "label": "Font weight",
      "min": 100,
      "max": 900,
      "step": 100,
      "default": 400
    },
    {
      "type": "range",
      "id": "mobile_letter_spacing",
      "label": "Letter spacing",
      "min": -2,
      "max": 10,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_word_spacing",
      "label": "Word spacing",
      "min": -5,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Desktop typography"
    },
    {
      "type": "range",
      "id": "desktop_font_size",
      "label": "Font size",
      "min": 10,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "desktop_font_weight",
      "label": "Font weight",
      "min": 100,
      "max": 900,
      "step": 100,
      "default": 400
    },
    {
      "type": "range",
      "id": "desktop_letter_spacing",
      "label": "Letter spacing",
      "min": -2,
      "max": 10,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_word_spacing",
      "label": "Word spacing",
      "min": -5,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Responsive text"
    }
  ]
}
{% endschema %}
